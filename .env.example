# Sprint 0: sin secretos requeridos aún
# Los siguientes van a usarse en sprints posteriores; por ahora son comentarios.

# Sprint 1: configuración general
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sprint 2: Mercado Pago (checkout y pagos)
# MP_ACCESS_TOKEN=
# NEXT_PUBLIC_MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=

# Sprint 2: Supabase (base de datos, archivos, auth del admin)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sprint 3: Resend (emails transaccionales)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@uknowcalcos.com

# Nota: solo los secretos del servidor (sin prefijo NEXT_PUBLIC_)
# deben ir en .env.local; nunca en git, siempre en Vercel Secrets.
